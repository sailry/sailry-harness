{
  "name": "sailry-pairing-relay",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:rust": "node test/rust-e2e.mjs",
    "test:desktop": "node test/rust-e2e.mjs --desktop",
    "test:edgeone": "node test/rust-e2e.mjs --edgeone",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:edgeone": "esbuild 'cloud-functions/[[default]].ts' --bundle --platform=node --format=cjs --outfile=dist/edgeone.cjs",
    "build:node": "esbuild src/node/main.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs"
  },
  "dependencies": {
    "@edgeone/pages-blob": "0.0.16"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "wrangler": "4.114.0",
    "miniflare": "4.20260722.0",
    "esbuild": "0.28.1"
  }
}
