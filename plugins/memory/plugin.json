{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "memory",
  "version": "0.1.0",
  "description": "Manage project memory",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "storage": {"collections":[
        {"scope":"node","key":"memory/settings","schema":{
          "type":"object","required":["v","settings"],"properties":{
            "v":{"const":1},"settings":{"type":"object","properties":{
              "enabled":{"type":"boolean","default":true},
              "auto_write":{"type":"boolean","default":true},
              "context_bytes":{"type":"integer","minimum":2048,"maximum":65536,"default":8192},
              "review_after_days":{"type":"integer","minimum":1,"maximum":3650,"default":90}
            }}
          }
        }},
        {"scope":"node","key":"memory/catalog","schema":{
          "type":"object","required":["v","pages","active","archived","next"],"properties":{
            "v":{"const":1},"pages":{"type":"object","maxProperties":1280,
              "propertyNames":{"pattern":"^(0|[1-9][0-9]*)$"},"additionalProperties":{"type":"integer","minimum":1,"maximum":2}},
            "active":{"type":"integer","minimum":0,"maximum":512},
            "archived":{"type":"integer","minimum":0,"maximum":2048},
            "next":{"type":"integer","minimum":0,"maximum":9007199254740991}
          }
        }},
        {"scope":"node","prefix":"memory/entry/","schema":{
          "type":"object","required":["v","summary","hash","body_page","body_revision"],"properties":{
            "v":{"const":1},"hash":{"type":"string","pattern":"^[0-9a-f]{16}$"},
            "body_page":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
            "body_revision":{"type":"integer","minimum":1,"maximum":9007199254740991},
            "summary":{"type":"object","required":["id","project","title","kind","archived","revision","updated_at_ms"],"properties":{
              "id":{"type":"string","pattern":"^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"},
              "project":{"type":["string","null"]},"title":{"type":"string","minLength":1,"maxLength":160},
              "kind":{"enum":["user","feedback","project","reference"]},"archived":{"type":"boolean"},
              "revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
              "updated_at_ms":{"type":"integer","minimum":0,"maximum":9007199254740991}
            }}
          }
        }},
        {"scope":"node","prefix":"memory/body/","schema":{
          "type":"object","required":["v","bodies"],"properties":{
            "v":{"const":1},"bodies":{"type":"object","maxProperties":2,"additionalProperties":{
              "type":"object","required":["body","revision"],"properties":{
                "body":{"type":"string","maxLength":8192},
                "revision":{"type":"integer","minimum":1,"maximum":9007199254740991}
              }
            }}
          }
        }}
      ]},
      "actions": [
        "storage.read",
        "storage.write",
        "projects.read"
      ],
      "display": {
        "label": "Memory",
        "locales": {
          "zh-CN": "记忆"
        },
        "icon": "reicon:devices/cpu"
      },
      "description": {
        "label": "Manage project memory",
        "locales": {
          "zh-CN": "管理项目记忆"
        }
      },
      "settings_page": {
        "navigation": {
          "label": "Memory",
          "locales": {
            "zh-CN": "记忆"
          }
        },
        "placement": {
          "group": "ai",
          "order": 500
        },
        "entry": "dev.sailry.platform/desktop/settings.js"
      },
      "desktop": {
        "resources": [
          "dev.sailry.platform/desktop/settings.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/host/policy.js",
          "dev.sailry.platform/host/review.js",
          "dev.sailry.platform/host/tokenize.js",
          "dev.sailry.platform/host/model.js",
          "dev.sailry.platform/host/storage.js",
          "dev.sailry.platform/host/settings.js",
          "dev.sailry.platform/host/retrieval.js",
          "dev.sailry.platform/host/mutations.js"
        ]
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/policy.js",
          "dev.sailry.platform/host/review.js",
          "dev.sailry.platform/host/tokenize.js",
          "dev.sailry.platform/host/model.js",
          "dev.sailry.platform/host/storage.js",
          "dev.sailry.platform/host/settings.js",
          "dev.sailry.platform/host/retrieval.js",
          "dev.sailry.platform/host/mutations.js"
        ],
        "handlers": [
          "initialize",
          "beforeModel",
          "search",
          "review",
          "save",
          "forget",
          "consolidate",
          "result"
        ],
        "turn": {
          "initialize": "initialize",
          "before_model": "beforeModel"
        }
      },
      "tools": [
        {
          "name": "search_memory",
          "presentation": "details",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "description": "Search durable global and current-project memory. Pass a keyword, phrase, or an exact memory ID from the index. An empty query selects up to 20 recent active entries. The shared byte budget may omit or truncate results. IDs and revisions support updates.",
          "handler": {
            "name": "search",
            "read_only": true,
            "parameters": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                }
              },
              "required": [
                "query"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Search memory",
            "locales": {
              "zh-CN": "搜索记忆"
            },
            "icon": "reicon:devices/cpu"
          }
        },
        {
          "name": "review_memories",
          "presentation": "details",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "description": "Find possibly duplicate or old active memories in the current scope. Hints require factual verification; never archive based only on age or similarity.",
          "handler": {
            "name": "review",
            "read_only": true,
            "parameters": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Review memories",
            "locales": {
              "zh-CN": "整理记忆"
            },
            "icon": "reicon:devices/cpu"
          }
        },
        {
          "name": "save_memory",
          "presentation": "details",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "description": "Save one stable fact or correction. Search first to avoid duplicates. Omit id and use expected_revision=0 to create; otherwise search the exact ID, read its complete body, then pass the current id and revision. Keep applicable versions, branches and exceptions. Scope cannot change on an existing entry. Project scope is the default. Do not store secrets, transient work, or code history.",
          "handler": {
            "name": "save",
            "parameters": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "global": {
                  "type": "boolean"
                },
                "archived": {
                  "type": "boolean"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "feedback",
                    "project",
                    "reference"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "expected_revision",
                "kind",
                "title",
                "body"
              ],
              "additionalProperties": false
            },
            "operation": "storage.transaction",
            "result": "result"
          },
          "display": {
            "label": "Save memory",
            "locales": {
              "zh-CN": "保存记忆"
            },
            "icon": "reicon:devices/cpu"
          }
        },
        {
          "name": "forget_memory",
          "presentation": "details",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "description": "Permanently delete a memory only at the user's request, by ID and last-read revision. Prefer archiving stale facts with save_memory. Only global and current-project memories are accessible.",
          "handler": {
            "name": "forget",
            "parameters": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "expected_revision"
              ],
              "additionalProperties": false
            },
            "operation": "storage.transaction",
            "result": "result"
          },
          "display": {
            "label": "Forget memory",
            "locales": {
              "zh-CN": "删除记忆"
            },
            "icon": "reicon:devices/cpu"
          }
        },
        {
          "name": "consolidate_memories",
          "presentation": "details",
          "contexts": [
            "plugin",
            "workspace"
          ],
          "description": "Atomically replace an existing memory with a merged fact and archive its source entries. Read every complete body with search_memory before merging. Keep distinct conditions and conflicting facts separate. All entries must have the same scope. Pass the current revisions. Sources remain recoverable in management.",
          "handler": {
            "name": "consolidate",
            "parameters": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "revision": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "id",
                      "revision"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "expected_revision",
                "title",
                "body",
                "sources"
              ],
              "additionalProperties": false
            },
            "operation": "storage.transaction",
            "result": "result"
          },
          "display": {
            "label": "Merge memories",
            "locales": {
              "zh-CN": "合并记忆"
            },
            "icon": "reicon:devices/cpu"
          }
        }
      ]
    }
  }
}
