{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ssh",
  "version": "0.1.0",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "actions": [
        "ssh.read",
        "ssh.control",
        "ssh.manage",
        "conversation.read",
        "conversation.control",
        "projects.read"
      ],
      "display": {
        "label": "SSH",
        "locales": {
          "zh-CN": "SSH"
        },
        "icon": "reicon:it/terminal-square"
      },
      "description": {
        "label": "Connect and manage remote servers",
        "locales": {
          "zh-CN": "连接与管理远程服务器"
        }
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/tools.js",
          "dev.sailry.platform/host/instructions.js"
        ],
        "handlers": [
          "initialize",
          "run",
          "transfer"
        ],
        "turn": {
          "initialize": "initialize"
        }
      },
      "tools": [
        {
          "name": "ssh_run",
          "presentation": "details",
          "description": "Run a command on an allowed saved SSH connection after runtime approval. The connection must already have a trusted host key. Do not request credentials or bypass host-key verification.",
          "contexts": [
            "workspace",
            "ssh"
          ],
          "handler": {
            "name": "run",
            "operation": "ssh.run",
            "parameters": {
              "type": "object",
              "properties": {
                "connection": {
                  "type": "string",
                  "enum": [],
                  "description": "[]"
                },
                "command": {
                  "type": "string"
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 900000
                }
              },
              "required": [
                "connection",
                "command"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Run SSH command",
            "locales": {
              "zh-CN": "执行 SSH 命令"
            },
            "icon": "reicon:it/terminal-square",
            "input": {
              "summary": {
                "path": "/connection",
                "code": true
              },
              "content": {
                "path": "/command",
                "code": true
              }
            }
          }
        },
        {
          "name": "ssh_transfer",
          "presentation": "details",
          "description": "Upload or download a file using an allowed SSH connection after runtime approval. The local path is relative to the session worktree. Do not request credentials.",
          "contexts": [
            "workspace",
            "ssh"
          ],
          "handler": {
            "name": "transfer",
            "operation": "ssh.transfer",
            "parameters": {
              "type": "object",
              "properties": {
                "connection": {
                  "type": "string",
                  "enum": [],
                  "description": "[]"
                },
                "path": {
                  "type": "string"
                },
                "remote_path": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "upload",
                    "download"
                  ]
                }
              },
              "required": [
                "connection",
                "path",
                "remote_path",
                "direction"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Transfer SSH file",
            "locales": {
              "zh-CN": "传输 SSH 文件"
            },
            "icon": "reicon:it/terminal-square",
            "input": {
              "summary": {
                "path": "/connection",
                "code": true
              },
              "content": {
                "path": "/command",
                "code": true
              }
            }
          }
        }
      ],
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/editor-view.js",
          "dev.sailry.platform/desktop/editor.js",
          "dev.sailry.platform/desktop/files.js",
          "dev.sailry.platform/desktop/requests.js",
          "dev.sailry.platform/desktop/locales.js"
        ],
        "navigation": {
          "label": "SSH",
          "locales": {
            "zh-CN": "SSH"
          },
          "icon": "reicon:it/terminal-square"
        },
        "navigation_options": {
          "pinned": true,
          "order": 700,
          "target": "node",
          "details": true
        },
        "conversations": [
          {
            "id": "ssh",
            "resource": "ssh",
            "tools": [
              {
                "kind": "plugin",
                "name": "ssh_run"
              },
              {
                "kind": "plugin",
                "name": "ssh_transfer"
              }
            ],
            "context": "You are the SSH workspace assistant. Work only on the saved SSH connection exposed by your tools. Help inspect the remote system, diagnose issues, run requested commands, and transfer files. Establish the remote OS, working directory, and relevant state before choosing commands; do not assume they match the desktop. Use ssh_run for commands and ssh_transfer for transfers. Local transfer paths are relative to this session's project worktree, while remote paths belong to the SSH host. The runtime applies the session permission policy to each command and transfer: invoke the actual tool without asking for redundant permission in chat. Keep commands focused, bound output, and prefer inspection before changes. Clarify ambiguous targets with ask_user. Never request passwords or private keys, bypass host-key verification, access another connection, or claim a transfer succeeded without tool evidence. Do not automatically repeat interrupted or uncertain commands. Explain results concisely in the user's language. Use compact only to manage conversation context."
          }
        ]
      }
    }
  }
}
