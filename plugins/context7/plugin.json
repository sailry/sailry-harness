{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "context7",
  "version": "0.1.0",
  "description": "Current library documentation through the official Context7 MCP service",
  "homepage": "https://context7.com",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "scope": "host",
      "actions": [],
      "display": {
        "label": "Context7",
        "locales": {"zh-CN": "Context7"},
        "icon": "reicon:newicons/book-square"
      },
      "description": {
        "label": "Current library documentation",
        "locales": {"zh-CN": "查询最新库文档"}
      },
      "tools": [
        {
          "name": "resolve-library-id",
          "server": "context7",
          "display": {
            "label": "Find library",
            "locales": {"zh-CN": "查找库"},
            "icon": "reicon:ui/magnifier"
          }
        },
        {
          "name": "query-docs",
          "server": "context7",
          "display": {
            "label": "Read documentation",
            "locales": {"zh-CN": "查询文档"},
            "icon": "reicon:newicons/book-square"
          }
        }
      ]
    }
  }
}
