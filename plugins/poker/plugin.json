{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "poker",
  "version": "0.1.2",
  "description": "Play heads-up Texas Hold'em with an AI opponent",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "description": {"label": "Play heads-up Texas Hold'em with an AI opponent", "locales": {"zh-CN": "与 AI 对手玩德州扑克"}},
      "scope": "desktop",
      "actions": [
        "models.generate"
      ],
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "navigation": {
          "label": "Texas Hold'em",
          "locales": {
            "zh-CN": "德州扑克"
          },
          "icon": "reicon:like/heart"
        },
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/game.js",
          "dev.sailry.platform/desktop/cards.js",
          "dev.sailry.platform/desktop/model.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/desktop/table.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/controls.js",
          "dev.sailry.platform/desktop/history.js",
          "dev.sailry.platform/desktop/result.js",
          "dev.sailry.platform/desktop/motion.js",
          "dev.sailry.platform/desktop/card-back.svg",
          "dev.sailry.platform/desktop/layout.js",
          "dev.sailry.platform/desktop/assets/town-pattern.png",
          "dev.sailry.platform/desktop/assets/character-01.png",
          "dev.sailry.platform/desktop/assets/character-02.png"
        ]
      },
      "settings_schema": "dev.sailry.platform/settings.json",
      "display": {
        "label": "Texas Hold'em",
        "locales": {
          "zh-CN": "德州扑克"
        },
        "icon": "reicon:like/heart"
      }
    }
  }
}
