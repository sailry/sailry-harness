{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "player_1": {
      "type": "string",
      "title": "Name",
      "default": "",
      "maxLength": 24
    },
    "player_1_model": {
      "type": "string",
      "title": "Model",
      "x-sailry-model": true,
      "minLength": 1
    },
    "player_1_model_effort": {
      "type": "string",
      "title": "Reasoning",
      "x-sailry-model-effort": "player_1_model",
      "default": "none"
    },
    "player_name": {
      "type": "string",
      "title": "Name",
      "default": "",
      "maxLength": 24
    },
    "player_1_enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": true
    }
  },
  "x-sailry-locales": {
    "zh-CN": {
      "player_1": "名称",
      "player_1_model": "模型",
      "player_1_model_effort": "思考强度",
      "player_name": "名称",
      "player-tab-1": "玩家 1",
      "player_1_enabled": "启用",
      "player-tab-2": "玩家 2"
    }
  },
  "required": [
    "player_1_enabled"
  ],
  "x-sailry-tabs": [
    {
      "id": "player-tab-1",
      "title": "Player 1",
      "fields": [
        "player_name"
      ]
    },
    {
      "id": "player-tab-2",
      "title": "Player 2",
      "fields": [
        "player_1_enabled",
        "player_1",
        "player_1_model",
        "player_1_model_effort"
      ],
      "enabled": "player_1_enabled"
    }
  ]
}
