{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "databases",
  "version": "0.1.0",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "actions": [
        "databases.read",
        "databases.control",
        "databases.manage",
        "conversation.read",
        "conversation.control",
        "projects.read",
        "ssh.read"
      ],
      "display": {
        "label": "Databases",
        "locales": {
          "zh-CN": "数据库"
        },
        "icon": "reicon:ui/database"
      },
      "description": {
        "label": "Connect to databases and run queries",
        "locales": {
          "zh-CN": "连接数据库与执行查询"
        }
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/tools.js",
          "dev.sailry.platform/host/instructions.js"
        ],
        "handlers": [
          "initialize",
          "catalog",
          "query",
          "execute"
        ],
        "turn": {
          "initialize": "initialize"
        }
      },
      "tools": [
        {
          "name": "database_catalog",
          "presentation": "details",
          "description": "List databases, or tables in a selected database, using a saved connection. Credentials remain on the execution Node.",
          "contexts": [
            "workspace",
            "database"
          ],
          "handler": {
            "name": "catalog",
            "operation": "databases.catalog",
            "parameters": {
              "type": "object",
              "properties": {
                "connection": {
                  "type": "string",
                  "enum": [],
                  "description": "[]"
                },
                "database": {
                  "type": "string",
                  "description": "Database name; omit to use the saved default"
                }
              },
              "required": [
                "connection"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Database catalog",
            "locales": {
              "zh-CN": "数据库目录"
            },
            "icon": "reicon:ui/database",
            "input": {
              "summary": {
                "path": "/database",
                "code": true
              },
              "content": {
                "path": "/sql",
                "code": true
              }
            }
          }
        },
        {
          "name": "database_query",
          "presentation": "content",
          "description": "Run one read-only SQL statement without approval. The execution connection is forced read-only. Use this for SELECT, inspecting schema, and analysis. Results also appear in the database workspace. Use database_execute for writes; never try to disable read-only protection.",
          "contexts": [
            "workspace",
            "database"
          ],
          "handler": {
            "name": "query",
            "operation": "databases.query",
            "parameters": {
              "type": "object",
              "properties": {
                "connection": {
                  "type": "string",
                  "enum": [],
                  "description": "[]"
                },
                "database": {
                  "type": "string",
                  "description": "Database name; omit to use the saved default"
                },
                "sql": {
                  "type": "string"
                }
              },
              "required": [
                "connection",
                "sql"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Query database",
            "locales": {
              "zh-CN": "查询数据库"
            },
            "icon": "reicon:ui/database",
            "input": {
              "summary": {
                "path": "/database",
                "code": true
              },
              "content": {
                "path": "/sql",
                "code": true
              }
            },
            "output": {
              "table": {
                "columns": {
                  "source": "result",
                  "path": "/data/data/columns"
                },
                "rows": {
                  "source": "result",
                  "path": "/data/data/rows"
                },
                "truncated": {
                  "source": "result",
                  "path": "/data/data/truncated"
                },
                "cell": {
                  "value": "/value",
                  "missing": "NULL",
                  "bytes": "hex"
                }
              }
            }
          }
        },
        {
          "name": "database_execute",
          "presentation": "details",
          "description": "Execute one SQL write statement under the session permission policy. Use for INSERT, UPDATE, DELETE, and schema changes. The saved connection's read-only setting still applies. Invoke this tool directly instead of asking for approval in chat. Do not retry a denied or uncertain write automatically.",
          "contexts": [
            "workspace",
            "database"
          ],
          "handler": {
            "name": "execute",
            "operation": "databases.execute",
            "parameters": {
              "type": "object",
              "properties": {
                "connection": {
                  "type": "string",
                  "enum": [],
                  "description": "[]"
                },
                "database": {
                  "type": "string",
                  "description": "Database name; omit to use the saved default"
                },
                "sql": {
                  "type": "string"
                }
              },
              "required": [
                "connection",
                "sql"
              ],
              "additionalProperties": false
            }
          },
          "display": {
            "label": "Execute SQL",
            "locales": {
              "zh-CN": "执行 SQL"
            },
            "icon": "reicon:ui/database",
            "input": {
              "summary": {
                "path": "/database",
                "code": true
              },
              "content": {
                "path": "/sql",
                "code": true
              }
            },
            "output": {
              "table": {
                "columns": {
                  "source": "result",
                  "path": "/data/data/columns"
                },
                "rows": {
                  "source": "result",
                  "path": "/data/data/rows"
                },
                "truncated": {
                  "source": "result",
                  "path": "/data/data/truncated"
                },
                "cell": {
                  "value": "/value",
                  "missing": "NULL",
                  "bytes": "hex"
                }
              }
            }
          }
        }
      ],
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/editor-view.js",
          "dev.sailry.platform/desktop/editor.js",
          "dev.sailry.platform/desktop/sql.js",
          "dev.sailry.platform/desktop/catalog.js",
          "dev.sailry.platform/desktop/history.js",
          "dev.sailry.platform/desktop/requests.js",
          "dev.sailry.platform/desktop/locales.js"
        ],
        "navigation": {
          "label": "Databases",
          "locales": {
            "zh-CN": "数据库"
          },
          "icon": "reicon:ui/database"
        },
        "navigation_options": {
          "pinned": true,
          "order": 800,
          "target": "node",
          "details": true
        },
        "conversations": [
          {
            "id": "database",
            "resource": "database",
            "tools": [
              {
                "kind": "plugin",
                "name": "database_catalog"
              },
              {
                "kind": "plugin",
                "name": "database_query"
              },
              {
                "kind": "plugin",
                "name": "database_execute"
              }
            ],
            "context": "You are the database workspace assistant. Work only with the saved connection exposed by your tools. Use referenced databases and tables as the user's context. Read the connection engine and quoting rules from the tool schema. Use MySQL backticks, and PostgreSQL or SQLite double quotes for identifiers. Use the database argument to select the database rather than assuming cross-database qualification. Inspect catalogs and schema before composing SQL; do not invent table or column names. Use database_query for read-only queries without asking permission. Prefer explicit columns and bounded results. Use database_execute for inserts, updates, deletes, and schema changes: the runtime reviews its exact SQL under the session permission policy. For updates or deletes, inspect matching rows first and use a precise predicate; clarify ambiguous targets with ask_user. Respect the saved connection's read-only setting. Never disable protections, request credentials, or work around a denied operation. Query results already appear in the data grid and SQL log: summarize useful findings instead of repeating large tables. Do not execute a query twice merely to display it. Report errors and uncertain outcomes honestly; never automatically replay a write. Reply in the user's language. Use compact only to manage conversation context."
          }
        ]
      }
    }
  }
}
