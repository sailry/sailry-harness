{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "liars-dice",
  "version": "0.1.1",
  "description": "Play Liar's Dice with two AI opponents",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "description": {"label": "Play Liar's Dice with two AI opponents", "locales": {"zh-CN": "与 AI 对手玩骗子骰子"}},
      "scope": "desktop",
      "actions": [
        "models.generate"
      ],
      "desktop": {
        "entry": "dev.sailry.platform/desktop/main.js",
        "navigation": {
          "label": "Liar's Dice",
          "locales": {
            "zh-CN": "骗子骰子"
          },
          "icon": "reicon:ui/box"
        },
        "resources": [
          "dev.sailry.platform/desktop/main.js",
          "dev.sailry.platform/desktop/game.js",
          "dev.sailry.platform/desktop/model.js",
          "dev.sailry.platform/desktop/locales.js",
          "dev.sailry.platform/desktop/table.js",
          "dev.sailry.platform/desktop/view.js",
          "dev.sailry.platform/desktop/motion.js"
        ]
      },
      "settings_schema": "dev.sailry.platform/settings.json",
      "display": {
        "label": "Liar's Dice",
        "locales": {
          "zh-CN": "骗子骰子"
        },
        "icon": "reicon:ui/box"
      }
    }
  }
}
