SAILRY_NATIVE_PLATFORM[sdk=iphoneos*] = ios
SAILRY_NATIVE_PLATFORM[sdk=iphonesimulator*] = ios-simulator
SAILRY_GO_ARCH_arm64 = arm64
SAILRY_GO_ARCH_x86_64 = amd64
SAILRY_NATIVE_DIR = $(SRCROOT)/../../../.runtime/native/$(SAILRY_NATIVE_PLATFORM)-$(SAILRY_GO_ARCH_$(CURRENT_ARCH))
LIBRARY_SEARCH_PATHS = $(inherited) "$(SAILRY_NATIVE_DIR)"
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SAILRY_NATIVE_DIR)"
OTHER_LDFLAGS = $(inherited) -Wl,-force_load,$(SAILRY_NATIVE_DIR)/libsailry_mobile.a -Wl,-exported_symbol,_sailry_open -Wl,-exported_symbol,_sailry_invoke -Wl,-exported_symbol,_sailry_subscribe -Wl,-exported_symbol,_sailry_cancel -Wl,-exported_symbol,_sailry_free -Wl,-exported_symbol,_sailry_close -framework SailryIroh -framework CoreFoundation -framework Security -lresolv
