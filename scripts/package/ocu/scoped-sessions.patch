diff --git a/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/SessionOwnership.swift b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/SessionOwnership.swift
new file mode 100644
index 0000000..6661cb3
--- /dev/null
+++ b/packages/OpenComputerUseKit/Sources/OpenComputerUseKit/SessionOwnership.swift
@@ -0,0 +1,67 @@
+import Foundation
+
+/// All tool requests and releases use the same serialized boundary. The value
+/// remains visible to synchronous main-thread cursor work during a request.
+enum SessionOwnership {
+    private static let lock = NSRecursiveLock()
+    nonisolated(unsafe) static var current: UUID?
+
+    static func withOwner<T>(_ owner: UUID?, _ body: () throws -> T) rethrows -> T {
+        lock.lock()
+        let previous = current
+        current = owner
+        defer {
+            current = previous
+            lock.unlock()
+        }
+        return try body()
+    }
+}
+
+/// The first acquisition captures the original state; overlapping sessions
+/// share that capture until its final owner has restored it successfully.
+struct OwnedState<Value> {
+    let original: Value
+    private(set) var owners: Set<UUID>
+
+    init(_ original: Value, owner: UUID) {
+        self.original = original
+        owners = [owner]
+    }
+
+    mutating func acquire(_ owner: UUID) {
+        owners.insert(owner)
+    }
+
+    mutating func release(_ owner: UUID, restore: (Value) throws -> Void) rethrows -> Bool {
+        guard owners.contains(owner) else { return false }
+        if owners.count > 1 {
+            owners.remove(owner)
+            return false
+        }
+        try restore(original)
+        owners.remove(owner)
+        return true
+    }
+}
+
+struct CursorOwnership {
+    private(set) var owner: UUID?
+    private(set) var revision: UInt64 = 0
+
+    mutating func acquire(_ owner: UUID) {
+        self.owner = owner
+        revision &+= 1
+    }
+
+    mutating func release(_ owner: UUID) -> Bool {
+        guard self.owner == owner else { return false }
+        clear()
+        return true
+    }
+
+    mutating func clear() {
+        owner = nil
+        revision &+= 1
+    }
+}
