diff --git a/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/SessionOwnershipTests.swift b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/SessionOwnershipTests.swift
new file mode 100644
index 0000000..48e6c5d
--- /dev/null
+++ b/packages/OpenComputerUseKit/Tests/OpenComputerUseKitTests/SessionOwnershipTests.swift
@@ -0,0 +1,78 @@
+import XCTest
+@testable import OpenComputerUseKit
+
+final class SessionOwnershipTests: XCTestCase {
+    func testSharedWindowPreservesFirstState() throws {
+        let first = UUID(), second = UUID()
+        var window = OwnedState("original position", owner: first)
+        window.acquire(second)
+        window.acquire(first)
+        var restored: [String] = []
+        XCTAssertFalse(window.release(first) { restored.append($0) })
+        XCTAssertTrue(restored.isEmpty)
+        XCTAssertEqual(window.owners, [second])
+        XCTAssertTrue(window.release(second) { restored.append($0) })
+        XCTAssertEqual(restored, ["original position"])
+        XCTAssertFalse(window.release(second) { restored.append($0) })
+        XCTAssertEqual(restored.count, 1)
+    }
+
+    func testSeparateWindowsStayIndependent() {
+        let first = UUID(), second = UUID()
+        var windows = [1: OwnedState("first", owner: first), 2: OwnedState("second", owner: second)]
+        var restored: [String] = []
+        for key in windows.keys {
+            _ = windows[key]?.release(first) { restored.append($0) }
+        }
+        XCTAssertEqual(restored, ["first"])
+        XCTAssertEqual(windows[2]?.owners, [second])
+        XCTAssertFalse(windows[2]!.release(UUID()) { restored.append($0) })
+        XCTAssertEqual(restored, ["first"])
+    }
+
+    func testFailedRestorationCanRetry() {
+        enum Failure: Error { case unavailable }
+        let owner = UUID()
+        var window = OwnedState("original", owner: owner)
+        XCTAssertThrowsError(try window.release(owner) { _ in throw Failure.unavailable })
+        XCTAssertEqual(window.owners, [owner])
+        var restored = ""
+        XCTAssertTrue(window.release(owner) { restored = $0 })
+        XCTAssertEqual(restored, "original")
+        XCTAssertTrue(window.owners.isEmpty)
+    }
+
+    func testCursorCannotReleaseAnotherOwner() {
+        let first = UUID(), second = UUID()
+        var cursor = CursorOwnership()
+        cursor.acquire(first)
+        let oldRevision = cursor.revision
+        cursor.acquire(second)
+        XCTAssertFalse(cursor.release(first))
+        XCTAssertEqual(cursor.owner, second)
+        XCTAssertNotEqual(cursor.revision, oldRevision)
+        XCTAssertTrue(cursor.release(second))
+        XCTAssertNil(cursor.owner)
+        XCTAssertFalse(cursor.release(second))
+    }
+
+    func testDiagnosticsCannotAcquireToolOwnership() {
+        let owner = UUID()
+        SessionOwnership.withOwner(owner) {
+            XCTAssertEqual(SessionOwnership.current, owner)
+            SessionOwnership.withOwner(nil) { XCTAssertNil(SessionOwnership.current) }
+            XCTAssertEqual(SessionOwnership.current, owner)
+        }
+        XCTAssertNil(SessionOwnership.current)
+    }
+
+    func testSessionEndIsIdempotent() {
+        var resets = 0
+        let server = StdioMCPServer(backgroundStateReset: { resets += 1 })
+        XCTAssertTrue(server.endSession())
+        XCTAssertTrue(server.endSession())
+        XCTAssertEqual(resets, 1)
+        let response = server.handle(line: #"{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"list_apps","arguments":{}}}"#)
+        XCTAssertTrue(response?.contains("Tool session has ended") == true)
+    }
+}
