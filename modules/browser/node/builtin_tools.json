    {
      "name": "browser_screenshot",
      "legacy_package": "browser",
      "description": "Capture the built-in browser viewport, a CSS selector, an element from browser_read or a viewport rectangle on supported controllers. Elements scroll into view first. Returns the image with its bounds and element text; images lists references for showing the capture in a reply. Set save=true only when a project file is needed; saving requires approval.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "tab": {
            "minimum": 0,
            "type": "integer"
          },
          "target": {
            "description": "Omit for the visible viewport; rect uses viewport CSS pixels",
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "selector"
                  },
                  "selector": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "selector"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "element"
                  },
                  "snapshot": {
                    "type": "string"
                  },
                  "element": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "snapshot",
                  "element"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "rect"
                  },
                  "x": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "y": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "width": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "height": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "type": "object"
              }
            ]
          },
          "scale": {
            "default": "css",
            "description": "css uses one pixel per CSS pixel; device keeps device pixels",
            "enum": [
              "css",
              "device"
            ],
            "type": "string"
          },
          "format": {
            "default": "jpeg",
            "enum": [
              "jpeg",
              "png"
            ],
            "type": "string"
          },
          "save": {
            "default": false,
            "description": "Also save the capture in the project; requires approval",
            "type": "boolean"
          }
        },
        "required": [
          "tab"
