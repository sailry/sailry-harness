{
  "tools": [
    {
      "name": "code_search",
      "legacy_package": "code",
      "description": "Find where functions, types, methods, constants or modules are defined, by name or partial name. Faster and more precise than text search when you know or can guess the identifier. Use code_context or code_impact for call sites and search_files for strings or comments.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4096,
            "description": "Identifier or words to match against symbol names, paths and signatures"
          },
          "name": {
            "type": "string",
            "maxLength": 512,
            "description": "Case-insensitive symbol-name substring"
          },
          "path": {
            "type": "string",
            "description": "Worktree-relative file or directory"
          },
          "language": {
            "type": "string",
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "operation": "code.search",
      "stream_read": true,
      "contexts": [
        "plugin",
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "Search code",
        "locales": {
          "en": "Search code",
          "zh-CN": "检索代码",
          "zh-TW": "搜尋程式碼",
          "ja": "コードを検索",
          "ko": "코드 검색",
          "de": "Code suchen",
          "es": "Buscar código",
          "fr": "Rechercher du code",
          "pt-BR": "Pesquisar código",
          "ru": "Поиск кода"
        },
        "icon": "reicon:ui/magnifier",
        "input": {
          "summary": {
            "path": "/query"
          }
        }
      }
    },
    {
      "name": "code_outline",
      "legacy_package": "code",
      "description": "List the declarations in one file (functions, types, methods) with line ranges. Use before reading a large file.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path"
        ]
      },
      "operation": "code.outline",
      "stream_read": true,
      "contexts": [
        "plugin",
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "File structure",
        "locales": {
          "en": "File structure",
          "zh-CN": "文件结构",
          "zh-TW": "檔案結構",
          "ja": "ファイル構造",
          "ko": "파일 구조",
          "de": "Dateistruktur",
          "es": "Estructura del archivo",
          "fr": "Structure du fichier",
          "pt-BR": "Estrutura do arquivo",
          "ru": "Структура файла"
        },
        "icon": "reicon:it/code",
        "input": {
          "summary": {
            "path": "/path"
          }
        }
      }
    },
    {
      "name": "code_context",
      "legacy_package": "code",
      "description": "Find a definition by name and return its source with its callers, callees and impacted files in one call. Use instead of code_search followed by read_file.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "description": "Literal search terms for names, paths and short signatures."
          },
          "name": {
            "type": "string",
            "description": "Literal symbol-name substring."
          },
          "path": {
            "type": "string",
            "description": "Worktree-relative path prefix."
          },
          "language": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 20
          },
          "max_snippets": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 5
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 512,
            "maximum": 16384,
            "default": 16384
          }
        }
      },
      "action": "context",
      "read_only": true,
      "stream_read": true,
      "contexts": [
        "plugin",
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "Code context",
        "locales": {
          "en": "Code context",
          "zh-CN": "代码上下文",
          "zh-TW": "程式碼上下文",
          "ja": "コードのコンテキスト",
          "ko": "코드 컨텍스트",
          "de": "Codekontext",
          "es": "Contexto del código",
          "fr": "Contexte du code",
          "pt-BR": "Contexto do código",
          "ru": "Контекст кода"
        },
        "icon": "reicon:it/code",
        "input": {
          "summary": {
            "path": "/query"
          }
        }
      }
    },
    {
      "name": "code_impact",
      "legacy_package": "code",
      "description": "Before changing code, list the definitions and files that refer to a symbol, the definition at a file line, or a set of changed files, up to three reference hops away. References are matched by name; check confidence and ambiguous before relying on an edge.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Exact definition name."
          },
          "path": {
            "type": "string",
            "description": "Worktree-relative file that defines the symbol; required with line."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based line inside the definition in path."
          },
          "paths": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            },
            "description": "Changed worktree-relative files or directories; every definition they contain is a starting point."
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 3
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 16384,
            "default": 16384
          }
        }
      },
      "action": "impact",
      "read_only": true,
      "stream_read": true,
      "contexts": [
        "plugin",
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "Code impact",
        "locales": {
          "en": "Code impact",
          "zh-CN": "代码影响",
          "zh-TW": "程式碼影響",
          "ja": "コードへの影響",
          "ko": "코드 영향",
          "de": "Codeauswirkungen",
          "es": "Impacto en el código",
          "fr": "Impact sur le code",
          "pt-BR": "Impacto no código",
          "ru": "Влияние на код"
        },
        "icon": "reicon:newicons/hierarchy",
        "input": {
          "summary": {
            "path": "/name"
          }
        }
      }
    },
    {
      "name": "code_map",
      "legacy_package": "code",
      "description": "Rank the worktree's most referenced files with their key declarations and signatures, for orientation before exploring. Optional paths focus the ranking on files related to them; use next_offset for more files.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            },
            "description": "Worktree-relative files or directories to focus on."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 16384,
            "default": 16384
          }
        }
      },
      "action": "map",
      "read_only": true,
      "stream_read": true,
      "contexts": [
        "plugin",
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "Code map",
        "locales": {
          "en": "Code map",
          "zh-CN": "代码地图",
          "zh-TW": "程式碼地圖",
          "ja": "コードマップ",
          "ko": "코드 맵",
          "de": "Codeübersicht",
          "es": "Mapa del código",
          "fr": "Carte du code",
          "pt-BR": "Mapa do código",
          "ru": "Карта кода"
        },
        "icon": "reicon:business/diagram-tree"
      }
    },
    {
      "name": "code_pipeline",
      "legacy_package": "code",
      "description": "Chain dependent read-only workspace operations and return only the selected final data (16 KiB). Each follow-up binds at least one argument from the preceding result. For example, code.search by name, then files.read_lines with from_previous {\"path\":\"/symbols/0/path\",\"offset\":\"/symbols/0/range/start_line\",\"expected_revision\":\"/symbols/0/file_revision\"}. For independent reads, issue ordinary calls together.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "files.find",
                    "files.search",
                    "files.read_lines",
                    "code.search",
                    "code.outline",
                    "code.graph"
                  ]
                },
                "arguments": {
                  "type": "object",
                  "description": "Literal operation arguments."
                },
                "from_previous": {
                  "type": "object",
                  "description": "Argument names mapped to JSON pointers in the preceding result data. Required after the first step.",
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^(/|$)"
                  }
                }
              }
            }
          },
          "select": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(/|$)",
            "description": "JSON pointer in the final result data, e.g. /lines/0/text. Omit for the full final page."
          }
        }
      },
      "action": "pipeline",
      "read_only": true,
      "stream_read": true,
      "contexts": [
        "plugin",
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "Chained code reads",
        "icon": "reicon:it/code",
        "locales": {
          "en": "Chained code reads",
          "zh-CN": "组合读取",
          "zh-TW": "組合讀取",
          "ja": "連続読み取り",
          "ko": "연계 읽기",
          "de": "Verkettete Lesezugriffe",
          "es": "Lecturas encadenadas",
          "fr": "Lectures enchaînées",
          "pt-BR": "Leituras encadeadas",
          "ru": "Цепочка чтений"
        }
      }
    }
  ],
  "instructions": "Use code_search for symbol definitions, code_context for a definition with callers/callees in one call, code_outline for a file's declarations, code_impact before changing a shared cross-file symbol, and code_map to orient in an unfamiliar worktree. Graph edges match by name without type info (check confidence/ambiguous on important edges). These tools read saved source only (use search_files for text/comments, builds/tests for verification); line numbers are 1-based and paths are worktree-relative. Re-run after a revision conflict."
}
