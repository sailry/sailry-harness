{
  "tools": [
    {
      "name": "ssh_run",
      "legacy_package": "ssh",
      "description": "Run a command on a saved SSH connection available to this session. Resolve the connection ID with ssh_connections; do not recreate an existing connection when it is unavailable. A first connection requires the user to confirm the exact host fingerprint in the runtime approval. Do not request credentials, accept host keys or bypass verification.",
      "parameters": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
            "description": "[]"
          },
          "command": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        },
        "required": [
          "connection",
          "command"
        ],
        "additionalProperties": false
      },
      "operation": "ssh.run",
      "action": "run",
      "contexts": [
        "workspace",
        "ssh"
      ],
      "presentation": "details",
      "display": {
        "label": "Run SSH command",
        "locales": {
          "zh-CN": "执行 SSH 命令",
          "zh-TW": "執行 SSH 命令",
          "ja": "SSH コマンドを実行",
          "ko": "SSH 명령 실행",
          "fr": "Exécuter une commande SSH",
          "de": "SSH-Befehl ausführen",
          "es": "Ejecutar comando SSH",
          "pt-BR": "Executar comando SSH",
          "ru": "Выполнить команду SSH",
          "en": "Run SSH command"
        },
        "icon": "reicon:it/terminal-square",
        "input": {
          "summary": {
            "path": "/connection",
            "format": "connection",
            "result_path": "/connection_name"
          },
          "content": {
            "path": "/command",
            "code": true
          }
        },
        "output": {
          "preview": {
            "parts": [
              {
                "text": "stdout:\n",
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stdout"
                      },
                      "equals": null,
                      "negate": true
                    },
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stdout"
                      },
                      "equals": "",
                      "negate": true
                    }
                  ]
                }
              },
              {
                "value": {
                  "source": "result",
                  "path": "/data/stdout"
                }
              },
              {
                "text": "\n",
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stdout"
                      },
                      "equals": null,
                      "negate": true
                    },
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stdout"
                      },
                      "equals": "",
                      "negate": true
                    }
                  ]
                }
              },
              {
                "text": "stderr:\n",
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stderr"
                      },
                      "equals": null,
                      "negate": true
                    },
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stderr"
                      },
                      "equals": "",
                      "negate": true
                    }
                  ]
                }
              },
              {
                "value": {
                  "source": "result",
                  "path": "/data/stderr"
                }
              },
              {
                "text": "\n",
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stderr"
                      },
                      "equals": null,
                      "negate": true
                    },
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/stderr"
                      },
                      "equals": "",
                      "negate": true
                    }
                  ]
                }
              },
              {
                "text": "exit_code: ",
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/exit_code"
                      },
                      "equals": null,
                      "negate": true
                    }
                  ]
                }
              },
              {
                "value": {
                  "source": "result",
