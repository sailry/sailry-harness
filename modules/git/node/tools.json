            "type": "string",
            "description": "Path of the selected file entry in this snapshot; required on every page"
          },
          "expected_metadata_revision": {
            "type": "string",
            "description": "The selected file entry's metadata_revision, not snapshot.metadata_revision"
          },
          "expected_revision": {
            "type": [
              "string",
              "null"
            ],
            "description": "Strong revision of this file from the review scope or a previous read; required for continuation"
