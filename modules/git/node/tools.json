            "path": "/path"
          }
        },
        "output": {
          "preview": {
            "parts": [
              {
                "value": {
                  "source": "result",
                  "path": "/data/old_path"
                },
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "result",
                        "path": "/data/old_path"
                      },
                      "equals": null,
                      "negate": true
                    }
                  ]
                }
              },
              {
                "rows": {
                  "value": {
                    "source": "result",
                    "path": "/data/lines"
                  },
                  "text": {
                    "parts": [
                      {
                        "text": "+",
                        "when": {
                          "all": [
                            {
                              "value": {
                                "source": "item",
                                "path": "/kind"
                              },
                              "equals": "added"
                            }
                          ]
                        }
                      },
                      {
                        "text": "-",
                        "when": {
                          "all": [
                            {
                              "value": {
