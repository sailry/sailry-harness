    {
      "name": "read_git_change",
      "legacy_package": "git",
      "description": "Read a literal file diff from a returned Git changes snapshot. Every request requires the unchanged snapshot, the selected file's path and its metadata_revision as expected_metadata_revision. Do not use snapshot.metadata_revision for the file revision. The first request uses offset=0; omit expected_revision unless a strong file revision is already captured. Every continuation or later check supplies the returned strong revision. offset counts mapped diff lines, limit defaults to 200 and is at most 500. Complete source lines preserve whitespace except terminal CR/LF and carry one-based old/new line numbers. Pages are bounded to 48 KiB encoded JSON without truncating lines. Binary, non-UTF-8, unsupported modes, oversized files and oversized lines return an explicit skip_reason. Commit snapshots remain fixed when references move; working snapshots reject metadata or content changes. Files are bounded to 32 MiB. Select only registered worktrees in this session project.",
      "parameters": {
        "type": "object",
        "properties": {
          "worktree": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot": {
            "type": "object",
            "description": "Complete snapshot returned by the change inventory or review scope; pass it unchanged on every page"
