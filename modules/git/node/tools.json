                                "path": "/kind"
                              },
                              "equals": "deleted"
                            }
                          ]
                        }
                      },
                      {
                        "text": " ",
                        "when": {
                          "all": [
                            {
                              "value": {
                                "source": "item",
                                "path": "/kind"
                              },
                              "equals": "context"
                            }
                          ]
                        }
                      },
                      {
                        "value": {
                          "source": "item",
                          "path": "/text"
                        }
                      }
                    ]
                  },
                  "separator": "\n"
                }
              },
              {
                "value": {
                  "source": "result",
                  "path": "/data/skip_reason"
                }
