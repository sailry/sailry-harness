    {
      "name": "git_log",
      "legacy_package": "git",
      "description": "Read a page of Git commit history, optionally starting at revision and filtering a literal worktree-relative path. For the first page omit cursor or pass null, for example {\"limit\":5,\"cursor\":null}. For subsequent pages pass the exact next cursor and keep the same path filter. Cursors contain the frozen traversal head, last commit ID and cumulative row offset; never construct them from a short hash, HEAD, branch name or numeric offset. An empty repository returns an empty history. Omit worktree for this turn's directory, or select a registered worktree ID from list_worktrees in the same project.",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "Requested rows; each response has an independent output budget and may return a continuation"
          },
          "cursor": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "head": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "after": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "head",
              "after",
              "offset"
            ],
            "additionalProperties": false,
            "description": "Omit or use null for the first page; otherwise pass the exact returned cursor"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "description": "Starting revision for the first page; omit for HEAD. Continuations keep the cursor's frozen head"
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Literal worktree-relative file or directory; keep the same filter when continuing. Changes are compared with each commit's first parent"
          },
          "worktree": {
            "type": [
              "string",
              "null"
            ],
            "description": "Registered worktree ID in this turn's project; omit for the current worktree"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "operation": "git.log",
      "action": "log",
      "stream_read": true,
      "contexts": [
        "workspace"
      ],
      "presentation": "summary",
      "display": {
        "label": "Git history",
        "locales": {
          "zh-CN": "Git 日志",
          "zh-TW": "Git 歷史",
          "ja": "Git の履歴",
          "ko": "Git 기록",
          "fr": "Historique Git",
          "de": "Git-Verlauf",
          "es": "Historial de Git",
          "pt-BR": "Histórico do Git",
          "ru": "История Git",
          "en": "Git history"
        },
        "icon": {
          "svg": "<svg\n    xmlns=\"http://www.w3.org/2000/svg\"\n    width=\"24\"\n    height=\"24\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    stroke-width=\"2\"\n    stroke-linecap=\"round\"\n    stroke-linejoin=\"round\"\n><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\" /><rect\n        x=\"2\"\n        y=\"16\"\n        width=\"6\"\n        height=\"6\"\n        rx=\"1\"\n    /><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\" /><path\n        d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"\n    /><path d=\"M12 12V8\" /></svg>"
        },
        "output": {
          "preview": {
            "parts": [
              {
                "rows": {
                  "value": {
                    "source": "result",
                    "path": "/data/entries"
                  },
                  "text": {
                    "parts": [
                      {
                        "value": {
                          "source": "item",
                          "path": "/id"
                        },
                        "take": 12
                      },
                      {
                        "text": "  "
                      },
                      {
                        "value": {
                          "source": "item",
                          "path": "/author"
                        }
                      },
                      {
                        "text": "\n"
                      },
                      {
                        "value": {
                          "source": "item",
                          "path": "/message"
                        }
                      }
                    ]
                  },
                  "separator": "\n\n"
                }
              }
            ]
          },
          "notices": [
            {
              "message": {
                "label": "Invalid Git history cursor; use the full cursor returned by the tool",
                "locales": {
                  "zh-CN": "Git 分页游标无效，请使用工具返回的完整游标"
                }
              },
              "when": {
                "any": [
                  {
                    "value": {
                      "source": "result",
                      "path": "/message"
                    },
                    "equals": "expected a full Git commit object ID"
                  }
                ]
              }
            }
          ]
        }
      }
