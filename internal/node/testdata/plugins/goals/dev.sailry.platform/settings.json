{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_limit",
    "token_budget",
    "time_limit"
  ],
  "properties": {
    "turn_limit": {
      "type": "integer",
      "title": "Automatic turn limit",
      "default": 25,
      "minimum": 1,
      "maximum": 100
    },
    "token_budget": {
      "type": "integer",
      "title": "Token budget (thousands, 0 for none)",
      "default": 0,
      "minimum": 0,
      "maximum": 1000000000
    },
    "time_limit": {
      "type": "integer",
      "title": "Time limit (minutes, 0 for none)",
      "default": 0,
      "minimum": 0,
      "maximum": 100000
    }
  },
  "x-sailry-locales": {
    "en": {
      "turn_limit": "Automatic turn limit",
      "token_budget": "Token budget (thousands, 0 for none)",
      "time_limit": "Time limit (minutes, 0 for none)"
    },
    "zh-CN": {
      "turn_limit": "自动轮次上限",
      "token_budget": "Token 预算（千，0 为不限）",
      "time_limit": "时间上限（分钟，0 为不限）"
    }
  }
}
