{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "github",
  "version": "1.0.0",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "connectors": [{
        "id": "github",
        "display": {"label": "GitHub"},
        "accounts": "single",
        "origins": [],
        "inject": [],
        "auth": [
          {"kind": "secret", "fields": ["token"]},
          {
            "kind": "local_cli",
            "command": "gh",
            "status": {
              "argv": ["auth", "status", "--active", "--hostname", "github.com", "--json", "hosts"],
              "account": "/hosts/github.com/0/login",
              "condition": {"pointer": "/hosts/github.com/0/active", "values": [true]}
            },
            "token": {"argv": ["auth", "token", "--hostname", "github.com", "--user", "{account}"], "parse": "line"},
            "timeout_ms": 15000,
            "max_output": 65536
          }
        ],
        "fields": [{"name": "token", "title": "Token", "secret": true}]
      }]
    }
  }
}
