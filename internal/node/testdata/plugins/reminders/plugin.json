{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "reminders",
  "version": "0.1.20",
  "description": "To-dos and scheduled reminders",
  "extensions": {
    "dev.sailry.platform": {
      "api_version": "v1",
      "min_sailry_version": "0.2.0-alpha.2",
      "storage": {
        "collections": [
          {
            "scope": "node",
            "prefix": "reminder/",
            "schema": {
              "type": "object",
              "required": [
                "id",
                "project",
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                },
                "project": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null,
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "message": {
                  "type": "string",
                  "default": "",
                  "maxLength": 4096
                },
                "completed": {
                  "type": "boolean",
                  "default": false
                },
                "due_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "default": null,
                  "minimum": 0
                },
                "notified_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "default": null,
                  "minimum": 0
                },
                "execution_node": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "minItems": 32,
                  "maxItems": 32,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  }
                }
              }
            }
          }
        ]
      },
      "description": {
        "label": "To-dos and scheduled reminders",
        "locales": {
          "zh-CN": "管理待办与定时提醒"
        }
      },
      "actions": [
        "storage.read",
        "storage.write",
        "dispatch.manage",
        "notifications.publish",
        "projects.read"
      ],
      "display": {
        "label": "Reminders",
        "locales": {
          "zh-CN": "待办提醒"
        },
        "icon": "phosphor:bell"
      },
      "host": {
        "entry": "dev.sailry.platform/host/main.js",
        "resources": [
          "dev.sailry.platform/host/main.js",
          "dev.sailry.platform/host/records.js",
          "dev.sailry.platform/host/schedules.js",
          "dev.sailry.platform/host/mutations.js",
          "dev.sailry.platform/host/tools.js",
          "dev.sailry.platform/host/locales.js"
        ],
        "handlers": [
          "list",
          "record",
          "save",
          "remove",
          "notify",
          "history",
          "initialize",
          "reminders"
        ],
        "turn": {
          "initialize": "initialize"
        },
        "read_only": [
          "list",
          "record",
          "history"
        ]
      },
      "tools": [
        {
          "name": "reminders",
          "contexts": [
            "workspace",
            "plugin"
          ],
          "presentation": "summary",
          "description": "List, create, update or delete saved reminders. Project sessions use their current project; conversations without a project use unassigned reminders. These reminders are separate from conversation progress, update_plan and scheduled agent tasks. List optionally filters by completed and returns IDs, revisions and an after cursor; pass the latest revision for update or delete. Create requires a title; notes, completion and due_ms (UTC milliseconds or null) are optional. Update changes only supplied fields. Project scope is fixed by the session.",
          "handler": {
            "name": "reminders",
            "flow": {
              "operations": [
                "storage.transaction"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action"
              ],
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "list",
                    "create",
                    "update",
                    "delete"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "after": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "completed": {
                  "type": "boolean"
                },
                "due_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "action": {
                        "const": "create"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "title"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "action": {
                        "enum": [
                          "update",
                          "delete"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "id",
                      "revision"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "action": {
                        "const": "update"
                      }
                    }
                  },
                  "then": {
                    "anyOf": [
                      {
                        "required": [
                          "title"
                        ]
                      },
                      {
                        "required": [
                          "message"
                        ]
                      },
                      {
                        "required": [
                          "completed"
                        ]
                      },
                      {
                        "required": [
                          "due_ms"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          },
          "display": {
            "label": "Reminders",
            "locales": {
              "zh-CN": "待办提醒",
              "zh-TW": "提醒",
              "ja": "リマインダー",
              "ko": "알림",
              "fr": "Rappels",
              "de": "Erinnerungen",
              "es": "Recordatorios",
              "pt-BR": "Lembretes",
              "ru": "Напоминания",
              "en": "Reminders"
            },
            "icon": "reicon:notifications/bell",
            "input": {
              "summary": {
                "path": "/title"
              }
            },
            "approval": [
              {
                "message": {
                  "label": "Create reminder %{title}",
                  "locales": {
                    "zh-CN": "创建提醒 %{title}"
                  }
                },
                "values": {
                  "title": {
                    "source": "arguments",
                    "path": "/title"
                  }
                },
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "arguments",
                        "path": "/action"
                      },
                      "equals": "create"
                    }
                  ]
                }
              },
              {
                "message": {
                  "label": "Update reminder %{title}",
                  "locales": {
                    "zh-CN": "更新提醒 %{title}"
                  }
                },
                "values": {
                  "title": {
                    "source": "arguments",
                    "path": "/title"
                  }
                },
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "arguments",
                        "path": "/action"
                      },
                      "equals": "update"
                    },
                    {
                      "value": {
                        "source": "arguments",
                        "path": "/title"
                      },
                      "equals": null,
                      "negate": true
                    }
                  ]
                }
              },
              {
                "message": {
                  "label": "Update reminder %{id}",
                  "locales": {
                    "zh-CN": "更新提醒 %{id}"
                  }
                },
                "values": {
                  "id": {
                    "source": "arguments",
                    "path": "/id"
                  }
                },
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "arguments",
                        "path": "/action"
                      },
                      "equals": "update"
                    },
                    {
                      "value": {
                        "source": "arguments",
                        "path": "/title"
                      },
                      "equals": null
                    }
                  ]
                }
              },
              {
                "message": {
                  "label": "Delete reminder %{id}",
                  "locales": {
                    "zh-CN": "删除提醒 %{id}"
                  }
                },
                "values": {
                  "id": {
                    "source": "arguments",
                    "path": "/id"
                  }
                },
                "when": {
                  "all": [
                    {
                      "value": {
                        "source": "arguments",
                        "path": "/action"
                      },
                      "equals": "delete"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
}
