  {
    "operation": "notebook.edit",
    "description": "Atomically replace cell sources, insert cells or delete cells using the notebook revision. Indices refer to the original notebook; untouched metadata, IDs and outputs are retained. No kernel is executed",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Edit",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "expected_revision": {
          "type": "string"
        },
        "edits": {
          "description": "Indices refer to the notebook before this batch is applied.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "expected_revision",
        "edits"
