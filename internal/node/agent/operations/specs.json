                  "minimum": 0
                },
                "source": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "const": "replace"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "index",
                "source"
              ]
            },
            {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "cell_type": {
                  "$ref": "#/$defs/Kind"
                },
                "source": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "const": "insert"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "index",
                "cell_type",
                "source"
              ]
            },
            {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "kind": {
                  "type": "string",
                  "const": "delete"
                }
              },
              "additionalProperties": false,
              "required": [
                "kind",
                "index"
              ]
            }
          ]
        },
        "Kind": {
          "type": "string",
          "enum": [
            "code",
            "markdown",
            "raw"
          ]
        }
      }
    },
    "read_only": false,
    "concurrent": false
