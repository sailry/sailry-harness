  {
    "operation": "files.edit",
    "description": "Apply one replacement or a batch atomically using the current file revision. Match each edit against the original file; require a unique match unless replace_all is true and reject overlaps",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "old_text": {
          "type": "string",
          "minLength": 1
        },
        "new_text": {
          "type": "string"
        },
        "replace_all": {
          "type": "boolean",
          "default": false
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "old_text": {
                "type": "string",
                "minLength": 1
              },
              "new_text": {
                "type": "string"
              },
              "replace_all": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "old_text",
              "new_text"
            ],
            "additionalProperties": false
          }
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "required": [
        "path",
        "expected_revision"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "old_text",
            "new_text"
          ],
          "not": {
            "required": [
              "edits"
            ]
          }
        },
        {
          "required": [
            "edits"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "old_text"
                ]
              },
              {
                "required": [
                  "new_text"
                ]
              }
            ]
          },
          "properties": {
            "replace_all": {
              "const": false
            }
          }
        }
      ]
    },
    "read_only": false,
    "concurrent": false
  },
