    "concurrent": false
  },
  {
    "operation": "files.find",
    "description": "Find regular file paths by glob within path, respecting .gitignore and never following symlinks. Newest files come first. Use next_offset for another page; partial scans have no continuation",
    "parameters": {
      "type": "object",
      "properties": {
        "globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "path": {
          "type": "string",
          "default": ""
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "default": 500
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "globs"
      ],
      "additionalProperties": false
    },
    "read_only": true,
    "concurrent": true
  },
  {
    "operation": "files.search",
    "description": "Search UTF-8 files within path using embedded ripgrep matching, respecting .gitignore and never following symlinks. Matching paths are the default; select content rows or line counts when needed. type uses ripgrep language names; context adds neighboring lines; multiline permits newline-spanning matches. Use next_offset for complete-scan pagination; narrow path if partial",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "regex": {
          "type": "boolean",
          "default": false
        },
        "case_sensitive": {
          "type": "boolean",
          "default": false
        },
        "globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "path": {
          "type": "string",
          "default": ""
        },
        "mode": {
          "type": "string",
          "enum": [
            "content",
            "files",
            "count"
          ],
          "default": "files"
        },
        "context": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "multiline": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "read_only": true,
    "concurrent": true
  },
  {
    "operation": "office.read",
    "description": "Read document sections from a worktree path or a current-turn attachment ID",
    "parameters": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Read",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "offset": {
          "description": "Zero-based section offset. Long document parts continue in subsequent sections.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "$defs": {
        "Source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "path"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "attachment"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "read_only": true,
    "concurrent": true
  },
