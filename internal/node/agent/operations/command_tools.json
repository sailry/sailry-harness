{
  "tools": [
    {
      "name": "run_command",
      "operation": "process.run",
      "description": "Run a Node command (prefer dedicated file/search/edit tools when available). Foreground runs stop on exit or cancellation; at timeout_ms a still-running command moves to the background and returns its id. Use background=true (not &) for servers, watchers, or REPLs; check readiness via read_command with id, wait_ms, and until, write stdin via write_command, and terminate via stop_command. Non-service background commands stop when the turn stops.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "workspace",
              "unrestricted"
            ],
            "default": "workspace",
            "description": "Sandboxed workspace mode (macOS/Linux) needs no approval, confines writes to worktree/temp, protects Git metadata, and blocks network. Request unrestricted for Git writes, network, or external paths."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Short purpose shown before approval"
          },
          "cwd": {
            "type": "string",
            "default": "",
            "description": "Working directory (defaults to worktree; workspace access confines cwd inside it)"
          },
          "background": {
            "type": "boolean",
            "default": false
          },
          "follow_up": {
            "type": "boolean",
            "default": false,
            "description": "Resume on background completion (15m silence emits one stall notice)"
          },
          "service": {
            "type": "boolean",
            "default": false,
            "description": "Requires background=true; only for servers/watchers kept alive after the turn"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "default": 120000,
            "maximum": 600000
          },
          "attachments": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Attachment IDs copied to SAILRY_ATTACHMENTS/<id> for this command only"
          },
          "pty": {
            "type": "boolean",
            "default": false,
            "description": "Requires background=true; allocates a PTY merging stdout/stderr"
          }
        },
        "required": [
          "command"
        ]
      },
      "presentation": "content",
      "display": {
        "label": "Command",
        "locales": {
          "zh-CN": "命令",
          "zh-TW": "命令",
          "ja": "コマンド",
          "ko": "명령",
          "fr": "Commande",
          "de": "Befehl",
          "es": "Comando",
          "pt-BR": "Comando",
          "ru": "Команда",
          "en": "Command"
        },
        "icon": "reicon:it/terminal-square",
        "approval": [
          {
            "message": {
              "label": "%{command}",
              "locales": {
                "zh-CN": "%{command}"
              }
            },
            "values": {
              "command": {
                "source": "arguments",
                "path": "/command"
              }
            }
          },
          {
            "message": {
              "label": "%{description}",
              "locales": {
                "zh-CN": "%{description}"
              }
            },
            "values": {
              "description": {
                "source": "arguments",
                "path": "/description"
              }
            },
            "when": {
              "all": [
                {
                  "value": {
                    "source": "arguments",
                    "path": "/description"
                  },
                  "equals": null,
                  "negate": true
                }
              ]
            }
          }
        ],
        "input": {
          "summary": {
            "path": "/command",
            "code": true,
            "format": "command"
          },
          "context": {
            "path": "/cwd",
            "omit": [
              "."
            ]
          },
          "content": {
            "path": "/command"
          }
        }
      }
    },
    {
      "name": "read_command",
      "operation": "process.read",
      "description": "Inspect retained command streams (id + stream + offset/next_offset) or list session commands (omit id). Waited reads return data.wait as matched, output, exited, or deadline.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
            "description": "Command UUID from run_command or list; omit/null to list session commands"
          },
          "output": {
            "type": "object",
            "properties": {
              "call": {
                "type": "string"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            },
            "required": [
              "call",
              "revision"
            ],
            "additionalProperties": false
          },
          "stream": {
            "type": "string",
            "enum": [
              "stdout",
              "stderr"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000,
            "description": "Wait for new output, exit, or deadline (0 reads immediately)"
          },
          "until": {
            "type": "string",
            "minLength": 1,
            "description": "Requires id and wait_ms>0; returns on new substring match, exit, or deadline"
          }
        },
        "required": []
      },
      "presentation": "content",
      "display": {
        "label": "Read command",
        "locales": {
          "zh-CN": "读取命令",
          "zh-TW": "讀取命令",
          "ja": "コマンドを読む",
          "ko": "명령 읽기",
          "fr": "Lire la commande",
          "de": "Befehl lesen",
          "es": "Leer comando",
          "pt-BR": "Ler comando",
          "ru": "Прочитать команду",
          "en": "Read command"
        },
        "icon": "reicon:it/terminal-square"
      }
    },
    {
      "name": "stop_command",
      "operation": "process.stop",
      "description": "Stop a background command and its process group in this session. Pass the exact UUID returned as data.id by run_command or a listed command id; never a PID, filename or command text.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
            "description": "Exact background command UUID from run_command data.id or a listed command id"
          }
        },
        "required": [
          "id"
        ]
      },
      "presentation": "content",
      "display": {
        "label": "Stop command",
        "locales": {
          "zh-CN": "停止命令",
          "zh-TW": "停止命令",
          "ja": "コマンドを停止",
          "ko": "명령 중지",
          "fr": "Arrêter la commande",
          "de": "Befehl stoppen",
          "es": "Detener comando",
          "pt-BR": "Parar comando",
          "ru": "Остановить команду",
          "en": "Stop command"
        },
        "icon": "reicon:it/terminal-square"
      }
    },
    {
      "name": "write_command",
      "operation": "process.write",
      "description": "Send input to a running background command in this session. Pass the exact UUID returned as data.id by run_command or a listed command id (never a PID, filename or command text) and the input exactly, including a newline when submitting a line. Accepts at most 64 KiB of UTF-8 input. A success acknowledges queued input; use read_command to inspect the response. Cannot write to another session or a finished command. Writing to a command running with workspace access needs no approval; otherwise it follows the current permission policy.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
            "description": "Exact background command UUID from run_command data.id or a listed command id"
          },
          "input": {
            "type": "string",
            "description": "Input queued atomically; at most 65536 UTF-8 bytes per write"
          }
        },
        "required": [
          "id",
          "input"
        ]
      },
      "presentation": "summary",
      "display": {
        "label": "Write command",
        "locales": {
          "zh-CN": "输入命令",
          "zh-TW": "寫入命令",
          "ja": "コマンドに入力",
          "ko": "명령에 입력",
          "fr": "Écrire dans la commande",
          "de": "In Befehl schreiben",
          "es": "Escribir en el comando",
          "pt-BR": "Escrever no comando",
          "ru": "Ввод в команду",
          "en": "Write command"
        },
        "icon": "reicon:it/terminal-square"
      }
    }
  ],
  "notices": {
    "encoding": {
      "label": "Some output could not be decoded",
      "locales": {
        "zh-CN": "部分输出无法解码"
      }
    }
  }
}
