[package]
name = "gpui-pre-wgpu"
version = "0.3.7"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Zed's `gpui_wgpu` crate (gpui-pre snapshot of zed@1a28cff)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "gpui_wgpu"
zed-version = "0.1.0"
zed-rev = "1a28cff4b409169bac058bca40dfbfeb7621d19b"

[lib]
path = "src/gpui_wgpu.rs"
doctest = false
name = "gpui_wgpu"

[features]
default = []
bench-support = ["gpui/bench-support", "dep:image"]
font-kit = ["dep:font-kit"]
test-support = ["gpui/test-support", "dep:image"]

[dependencies]
gpui = { workspace = true }
anyhow = { workspace = true }
bytemuck = "1"
collections = { workspace = true }
cosmic-text = "0.19.0"
etagere = { workspace = true }
itertools = { workspace = true }
image = { workspace = true, optional = true }
log = { workspace = true }
parking_lot = { workspace = true }
profiling = { workspace = true }
raw-window-handle = { workspace = true }
smallvec = { workspace = true }
swash = { workspace = true }
unicode-bidi = { workspace = true }
unicode-segmentation = { workspace = true }
gpui_util = { workspace = true }
wgpu = { workspace = true }
font-kit = { git = "https://github.com/zed-industries/font-kit", rev = "94b0f28166665e8fd2f53ff6d268a14955c82269", package = "zed-font-kit", version = "0.14.1-zed", optional = true }

[target.'cfg(target_family = "wasm")'.dependencies]
web-sys = { version = "0.3", features = ["HtmlCanvasElement"] }
wgpu = { workspace = true, features = ["webgl"] }

[lints]
workspace = true

[[bench]]
name = "layout_line"
harness = false
