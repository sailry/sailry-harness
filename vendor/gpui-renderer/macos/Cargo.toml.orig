# Modified by Longbridge for gpui-fast publication.
[package]
name = "gpui-fast-macos"
version = "0.1.6"
edition = "2024"
publish = ["crates-io"]
license = "Apache-2.0"
repository = "https://github.com/longbridge/gpui-fast"
homepage = "https://github.com/longbridge/gpui-fast"
readme = "README.md"
documentation = "https://docs.rs/gpui-fast-macos/0.1.6/gpui_macos/"
description = "gpui_macos: GPUI with gpui-fast rendering and layout optimizations"
autoexamples = false
autobenches = false
autotests = false
authors = ["Longbridge"]
include = ["/src/**", "/resources/**", "/build.rs", "/Cargo.toml", "/README.md", "/LICENSE", "/NOTICE"]

[lib]
path = "src/gpui_macos.rs"
doctest = false
name = "gpui_macos"

[features]
default = ["gpui/default"]
bench-support = ["gpui/bench-support", "gpui_apple/bench-support"]
test-support = ["gpui/test-support", "gpui_apple/test-support"]
runtime_shaders = ["gpui_apple/runtime_shaders"]
font-kit = ["dep:font-kit", "dep:core-text", "dep:pathfinder_geometry"]
screen-capture = ["gpui/screen-capture", "dep:objc2-core-graphics", "dep:objc2-core-media", "dep:objc2-screen-capture-kit"]

[dependencies.gpui]
default-features = false
package = "gpui-fast"
version = "^0.1.6"
path = "../gpui"

[target."cfg(target_os = \"macos\")".dependencies.accesskit]
version = "0.24.0"
features = ["enumn"]

[target."cfg(target_os = \"macos\")".dependencies.accesskit_macos]
version = "0.26.0"

[target."cfg(target_os = \"macos\")".dependencies.anyhow]
version = "1.0.86"

[target."cfg(target_os = \"macos\")".dependencies.block2]
version = "0.6"

[target."cfg(target_os = \"macos\")".dependencies.cocoa]
version = "=0.26.0"

[target."cfg(target_os = \"macos\")".dependencies.collections]
version = "=0.3.8"
package = "gpui-pre-collections"

[target."cfg(target_os = \"macos\")".dependencies.core-foundation]
version = "0.10"

[target."cfg(target_os = \"macos\")".dependencies.core-foundation-sys]
version = "0.8.6"

[target."cfg(target_os = \"macos\")".dependencies.core-graphics]
version = "0.24"

[target."cfg(target_os = \"macos\")".dependencies.core-text]
version = "21"
optional = true

[target."cfg(target_os = \"macos\")".dependencies.core-video]
version = "0.5"
default-features = false
features = ["link"]

[target."cfg(target_os = \"macos\")".dependencies.ctor]
version = "1.0.12"

[target."cfg(target_os = \"macos\")".dependencies.dispatch2]
version = "0.3"
default-features = false
features = ["std", "block2", "objc2"]

[target."cfg(target_os = \"macos\")".dependencies.font-kit]
package = "zed-font-kit"
version = "0.14.1-zed"
default-features = false
optional = true
features = ["source"]

[target."cfg(target_os = \"macos\")".dependencies.foreign-types]
version = "0.5"

[target."cfg(target_os = \"macos\")".dependencies.futures]
version = "0.3.34"

[target."cfg(target_os = \"macos\")".dependencies.gpui_apple]
package = "gpui-fast-apple"
version = "^0.1.6"
path = "../gpui_apple"

[target."cfg(target_os = \"macos\")".dependencies.gpui_util]
package = "gpui-pre-util"
version = "=0.3.8"

[target."cfg(target_os = \"macos\")".dependencies.image]
version = "0.25.1"
default-features = false
features = ["bmp", "dds", "exr", "ff", "gif", "hdr", "ico", "jpeg", "png", "pnm", "qoi", "rayon", "tga", "tiff", "webp"]

[target."cfg(target_os = \"macos\")".dependencies.itertools]
version = "0.14.0"

[target."cfg(target_os = \"macos\")".dependencies.log]
version = "0.4"
default-features = false
features = ["std"]

[target."cfg(target_os = \"macos\")".dependencies.objc]
version = "0.2"

[target."cfg(target_os = \"macos\")".dependencies.objc2]
version = "0.6"

[target."cfg(target_os = \"macos\")".dependencies.objc2-app-kit]
version = "0.3.2"
default-features = false
features = ["NSAlert", "NSApplication", "NSButton", "NSControl", "NSDraggingItem", "NSGraphics", "NSImage", "NSOpenPanel", "NSPanel", "NSPasteboard", "NSResponder", "NSSavePanel", "NSScreen", "NSTrackingArea", "NSView", "NSWindow", "NSWorkspace", "block2", "objc2-core-foundation"]

[target."cfg(target_os = \"macos\")".dependencies.objc2-core-graphics]
version = "=0.3.2"
default-features = false
features = ["CGDirectDisplay"]
optional = true

[target."cfg(target_os = \"macos\")".dependencies.objc2-core-media]
version = "=0.3.2"
default-features = false
features = ["CMSampleBuffer", "objc2-core-video"]
optional = true

[target."cfg(target_os = \"macos\")".dependencies.objc2-foundation]
version = "=0.3.2"
default-features = false
features = ["NSArray", "NSAttributedString", "NSCoder", "NSData", "NSDate", "NSDictionary", "NSEnumerator", "NSError", "NSGeometry", "NSNull", "NSObjCRuntime", "NSObject", "NSProcessInfo", "NSRange", "NSRunLoop", "NSSet", "NSString", "NSURL", "NSValue", "objc2-core-foundation", "std"]

[target."cfg(target_os = \"macos\")".dependencies.objc2-screen-capture-kit]
version = "=0.3.2"
default-features = false
features = ["block2", "dispatch2", "objc2-core-graphics", "objc2-core-media", "SCShareableContent", "SCStream", "std"]
optional = true

[target."cfg(target_os = \"macos\")".dependencies.objc2-user-notifications]
version = "0.3"
default-features = false
features = ["std", "block2", "UNNotification", "UNNotificationAction", "UNNotificationCategory", "UNNotificationContent", "UNNotificationRequest", "UNNotificationResponse", "UNNotificationTrigger", "UNUserNotificationCenter"]

[target."cfg(target_os = \"macos\")".dependencies.parking_lot]
version = "0.12.1"

[target."cfg(target_os = \"macos\")".dependencies.pathfinder_geometry]
version = "0.5"
optional = true

[target."cfg(target_os = \"macos\")".dependencies.raw-window-handle]
version = "0.6"

[target."cfg(target_os = \"macos\")".dependencies.scheduler]
package = "gpui-pre-scheduler"
version = "=0.3.8"

[target."cfg(target_os = \"macos\")".dependencies.semver]
version = "1.0"
features = ["serde"]

[target."cfg(target_os = \"macos\")".dependencies.smallvec]
version = "1.6"
features = ["union", "const_new"]

[target."cfg(target_os = \"macos\")".dependencies.strum]
version = "0.28"
features = ["derive"]

[target."cfg(target_os = \"macos\")".dependencies.uuid]
version = "1.1"
features = ["serde"]

[lints.rust.unexpected_cfgs]
level = "allow"
