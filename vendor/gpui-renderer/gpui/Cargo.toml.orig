# Modified by Longbridge for gpui-fast publication.
[package]
name = "gpui-fast"
version = "0.1.6"
edition = "2024"
authors = ["Nathan Sobo <nathan@zed.dev>", "Longbridge"]
description = "gpui: GPUI with gpui-fast rendering and layout optimizations"
repository = "https://github.com/longbridge/gpui-fast"
publish = ["crates-io"]
license = "Apache-2.0"
homepage = "https://github.com/longbridge/gpui-fast"
readme = "README.md"
keywords = ["desktop", "gui", "immediate"]
categories = ["gui"]
documentation = "https://docs.rs/gpui-fast/0.1.6/gpui/"
autoexamples = false
autobenches = false
autotests = false
include = ["/src/**", "/resources/**", "/build.rs", "/Cargo.toml", "/README.md", "/LICENSE", "/NOTICE"]

[features]
default = ["font-kit", "wayland", "x11", "windows-manifest"]
test-support = ["collections/test-support", "http_client/test-support", "wayland", "x11", "proptest", "dep:futures-concurrency", "dep:postage", "dep:web-time"]
bench-support = ["profiler", "dep:criterion", "dep:bench_metrics"]
bench = ["bench-support"]
inspector = ["gpui_macros/inspector"]
leak-detection = []
font-kit = []
wayland = []
x11 = ["scap?/x11"]
screen-capture = ["scap", "dep:objc2-core-foundation", "dep:objc2-core-video", "dep:windows-capture"]
windows-manifest = ["dep:embed-resource"]
windows-manifest-provided-by-host = []
profiler = ["dep:hdrhistogram"]
stacker = ["dep:stacksafe"]

[lib]
path = "src/gpui.rs"
name = "gpui"

[dependencies]
num_cpus = "1.13"
parking = "2.0.0"
ttf-parser = "0.25"
seahash = "4.1"
waker-fn = "1.2.0"
lyon = "1.0"
pin-project = "1.1.10"

[dependencies.accesskit]
version = "0.24.0"
features = ["enumn"]

[dependencies.anyhow]
version = "1.0.86"

[dependencies.async-task]
version = "4.7"

[dependencies.backtrace]
version = "0.3"

[dependencies.bitflags]
version = "2.6.0"

[dependencies.collections]
version = "=0.3.8"
package = "gpui-pre-collections"

[dependencies.bench_metrics]
optional = true
package = "gpui-pre-bench-metrics"
version = "=0.3.8"

[dependencies.criterion]
version = "0.8.2"
features = ["html_reports"]
optional = true

[dependencies.ctor]
version = "1.0.12"

[dependencies.derive_more]
version = "2.1"
features = ["deref", "deref_mut", "from_str", "add", "add_assign", "mul", "mul_assign", "not"]

[dependencies.etagere]
version = "0.2"

[dependencies.futures]
version = "0.3.34"

[dependencies.futures-concurrency]
version = "7.7.1"
optional = true

[dependencies.gpui_macros]
package = "gpui-fast-macros"
version = "^0.1.6"
path = "../gpui_macros"

[dependencies.gpui_shared_string]
package = "gpui-pre-shared-string"
version = "=0.3.8"

[dependencies.http_client]
package = "gpui-pre-http-client"
version = "=0.3.8"

[dependencies.image]
version = "0.25.1"
default-features = false
features = ["bmp", "dds", "exr", "ff", "gif", "hdr", "ico", "jpeg", "png", "pnm", "qoi", "rayon", "tga", "tiff", "webp"]

[dependencies.inventory]
version = "0.3.19"

[dependencies.itertools]
version = "0.14.0"

[dependencies.log]
version = "0.4"
default-features = false
features = ["std"]

[dependencies.parking_lot]
version = "0.12.1"

[dependencies.postage]
version = "0.5"
default-features = false
optional = true
features = ["blocking"]

[dependencies.proptest]
features = ["attr-macro"]
optional = true
version = "1"

[dependencies.chrono]
version = "0.4"
default-features = true
features = ["std", "serde"]

[dependencies.profiling]
version = "1"

[dependencies.rand]
version = "0.9"
default-features = false
features = ["std", "std_rng", "os_rng", "small_rng", "thread_rng"]

[dependencies.raw-window-handle]
version = "0.6"

[dependencies.regex]
version = "1.5"
default-features = true
features = ["std", "perf"]

[dependencies.refineable]
package = "gpui-pre-refineable"
version = "=0.3.8"

[dependencies.scheduler]
package = "gpui-pre-scheduler"
version = "=0.3.8"

[dependencies.resvg]
version = "0.46.0"
default-features = false
features = ["text", "system-fonts", "memmap-fonts", "raster-images"]

[dependencies.usvg]
version = "0.46.0"
default-features = false

[dependencies.schemars]
version = "1.0"
default-features = false
features = ["std", "indexmap2", "derive"]

[dependencies.serde]
version = "1.0"
features = ["rc", "derive"]

[dependencies.serde_json]
version = "1.0.144"
features = ["preserve_order", "raw_value"]

[dependencies.slotmap]
version = "1.0.6"

[dependencies.smallvec]
version = "1.6"
features = ["union", "const_new"]

[dependencies.stacksafe]
version = "1.0"
optional = true

[dependencies.strum]
version = "0.28"
features = ["derive"]

[dependencies.sum_tree]
package = "gpui-pre-sum-tree"
version = "=0.3.8"

[dependencies.taffy]
version = "=0.14.0"
default-features = false
features = ["std", "taffy_tree", "flexbox", "grid", "block_layout", "float_layout", "content_size"]

[dependencies.thiserror]
version = "2.0.12"

[dependencies.gpui_util]
package = "gpui-pre-util"
version = "=0.3.8"

[dependencies.hdrhistogram]
version = "7"
default-features = false
optional = true

[dependencies.spin]
version = "0.10"
default-features = false
features = ["mutex", "spin_mutex", "lock_api"]

[dependencies.url]
version = "2.2"

[dependencies.uuid]
version = "1.1"
features = ["serde", "v4"]

[dependencies.web-time]
version = "1.1.0"
optional = true

[dependencies.heapless]
version = "0.9.2"

[target."cfg(all(target_arch = \"wasm32\", target_os = \"unknown\"))".dependencies.async-channel]
version = "2.5"
default-features = false

[target."cfg(not(all(target_arch = \"wasm32\", target_os = \"unknown\")))".dependencies.async-channel]
version = "2.5"
default-features = false
features = ["std"]

[target."cfg(not(target_family = \"wasm\"))".dependencies.pollster]
version = "0.4.0"

[target."cfg(target_family = \"wasm\")".dependencies.getrandom]
version = "0.3.4"
features = ["wasm_js"]

[target."cfg(target_family = \"wasm\")".dependencies.uuid]
version = "1.1"
features = ["serde", "js"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.core-video]
version = "0.5"
default-features = false
features = ["link"]

[target."cfg(target_os = \"macos\")".dependencies.objc2-core-foundation]
version = "=0.3.2"
default-features = false
optional = true

[target."cfg(target_os = \"macos\")".dependencies.objc2-core-video]
version = "=0.3.2"
default-features = false
features = ["CVBuffer", "CVImageBuffer"]
optional = true

[target."cfg(target_os = \"macos\")".dependencies.log]
version = "0.4"
default-features = false
features = ["std"]

[target."cfg(target_os = \"macos\")".dependencies.objc2]
version = "0.6"
optional = true

[target."cfg(target_os = \"macos\")".dependencies.objc2-metal]
version = "0.3"
optional = true

[target."cfg(any(target_os = \"linux\", target_os = \"freebsd\", target_os = \"windows\"))".dependencies.scap]
default-features = false
package = "zed-scap"
version = "0.0.8-zed"
optional = true

[target."cfg(any(target_os = \"linux\", target_os = \"android\"))".dependencies.libc]
version = "0.2"

[target."cfg(target_os = \"windows\")".dependencies.windows]
version = "0.62"
features = ["Data_Xml_Dom", "Foundation_Numerics", "Globalization_DateTimeFormatting", "Storage_Search", "Storage_Streams", "System_Threading", "UI_Notifications", "UI_ViewManagement", "Wdk_System_SystemServices", "Win32_Foundation", "Win32_Globalization", "Win32_Graphics_Direct3D", "Win32_Graphics_Direct3D11", "Win32_Graphics_Direct3D_Fxc", "Win32_Graphics_DirectComposition", "Win32_Graphics_DirectWrite", "Win32_Graphics_DirectManipulation", "Win32_Graphics_Dwm", "Win32_Graphics_Dxgi", "Win32_Graphics_Dxgi_Common", "Win32_Graphics_Gdi", "Win32_Graphics_Imaging", "Win32_Graphics_Hlsl", "Win32_Networking_WinSock", "Win32_Security", "Win32_Security_Credentials", "Win32_Security_Cryptography", "Win32_Storage_FileSystem", "Win32_Storage_Packaging_Appx", "Win32_System_Com", "Win32_System_Com_StructuredStorage", "Win32_System_Console", "Win32_System_Diagnostics_Debug", "Win32_System_DataExchange", "Win32_System_IO", "Win32_System_JobObjects", "Win32_System_LibraryLoader", "Win32_System_Memory", "Win32_System_Ole", "Win32_System_Performance", "Win32_System_Pipes", "Win32_System_Power", "Win32_System_RestartManager", "Win32_System_SystemInformation", "Win32_System_SystemServices", "Win32_System_Threading", "Win32_System_Variant", "Win32_System_WinRT", "Win32_UI_Controls", "Win32_UI_HiDpi", "Win32_UI_Input_Ime", "Win32_UI_Input_KeyboardAndMouse", "Win32_UI_Input_Pointer", "Win32_UI_Shell", "Win32_UI_Shell_Common", "Win32_UI_Shell_PropertiesSystem", "Win32_UI_WindowsAndMessaging", "Win32_Media", "Win32_System_RemoteDesktop", "Win32_System_WindowsProgramming"]

[target."cfg(target_os = \"windows\")".dependencies.windows-capture]
version = "=1.4.2"
optional = true

[build-dependencies.embed-resource]
version = "3.0"
optional = true

[lints.rust.unexpected_cfgs]
level = "allow"
