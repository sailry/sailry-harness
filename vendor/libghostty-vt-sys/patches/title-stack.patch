     pub fn deinit(self: *Handler) void {
         self.apc_handler.deinit();
+        self.clearTitles();
+    }
+
+    fn clearTitles(self: *Handler) void {
+        for (&self.titles) |*title| {
+            if (title.*) |text| self.terminal.gpa().free(text);
+            title.* = null;
+        }
+        self.title_depth = 0;
+    }
+
+    fn pushTitle(self: *Handler, index: u16) !void {
+        if (index > self.titles.len) return;
+        const title = try self.terminal.gpa().dupe(u8, self.terminal.getTitle() orelse "");
+        if (index == 0 and self.title_depth == self.titles.len) {
+            if (self.titles[0]) |text| self.terminal.gpa().free(text);
+            std.mem.copyForwards(?[]u8, self.titles[0..9], self.titles[1..10]);
+            self.titles[9] = null;
+            self.title_depth -= 1;
+        }
+        const slot = if (index == 0) self.title_depth else index - 1;
+        if (self.titles[slot]) |text| self.terminal.gpa().free(text);
+        self.titles[slot] = title;
+        if (index == 0) self.title_depth += 1;
+    }
+
+    fn popTitle(self: *Handler, index: u16) !void {
+        if (index > self.titles.len or (index == 0 and self.title_depth == 0)) return;
+        const slot = if (index == 0) self.title_depth - 1 else index - 1;
+        const title = self.titles[slot] orelse return;
+        try self.windowTitle(title);
+        if (index == 0) {
+            self.terminal.gpa().free(title);
+            self.titles[slot] = null;
+            self.title_depth -= 1;
+        }
     }
 
